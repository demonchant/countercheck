# Local-only app server. Keep HOST on loopback unless you add real authentication.
HOST=127.0.0.1
PORT=4173

# Concordium hosted Agent Registry service; read-only calls use this endpoint.
REGISTRY_MCP_URL=https://agent-registry-mcp.concordium.com
CONCORDIUM_NETWORK=ccd:4221332d34e1694168c2a0c0b3fd0f27

# Merchant identity and target. Set these only for a real configured testnet seller.
SELLER_BADGE=
SELLER_PAY_TO=
SELLER_RESOURCE_URL=

# Buyer-side Concordium agent. Its registered agentWallet must equal CCD_ACCOUNT_ADDRESS.
BUYER_BADGE=

# Concordium Testnet x402 facilitator. Keep the sponsor distinct from the buyer.
# Use the sponsor account address and a supported 32-byte hex Ed25519 account key.
CCD_FACILITATOR_ADDRESS=
CCD_FACILITATOR_PRIVATE_KEY=
FACILITATOR_HOST=127.0.0.1
FACILITATOR_PORT=4180
# Generate a random token locally (at least 32 characters); never commit it.
FACILITATOR_API_TOKEN=
# Keep false until you separately approve local Testnet signing/broadcast.
FACILITATOR_SETTLEMENT_ENABLED=false
FACILITATOR_MAX_AMOUNT_MICROCCD=1000000
# Operator-defined minimum sponsor balance reserve; chain submission remains authoritative for fee sufficiency.
FACILITATOR_MIN_SPONSOR_BALANCE_MICROCCD=10000
FACILITATOR_STORE_PATH=./data/facilitator-settlements

# Native CCD payment ceiling in microCCD (6 decimals). Example format only: 10000.
MAX_SPEND_MICROCCD=
SELLER_ASSET=CCD

# Payments are disabled by default. Enabling requires a real, reviewed testnet setup.
PAYMENTS_ENABLED=false
CCD_ACCOUNT_ADDRESS=
CCD_PRIVATE_KEY=

# Optional local audit log path; must stay outside public/static directories.
AUDIT_LOG_PATH=./data/receipts.jsonl

# Optional local Ollama agent host; no cloud model or API key is used.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
