# Local-only app server. Keep HOST on loopback unless you add real authentication.
HOST=127.0.0.1
PORT=4173
# Required only when running the buyer API remotely behind the Vercel server-side proxy.
BUYER_API_TOKEN=
BUYER_API_SERVICE=false

# Concordium hosted Agent Registry service; read-only calls use this endpoint.
REGISTRY_MCP_URL=https://agent-registry-mcp.concordium.com
CONCORDIUM_NETWORK=ccd:4221332d34e1694168c2a0c0b3fd0f27

# Merchant identity and target. Set these only for a real configured testnet seller.
SELLER_BADGE=
SELLER_PAY_TO=
SELLER_RESOURCE_URL=http://127.0.0.1:4191/resource
# Default off. Only run the local seller resource after reviewing the target and facilitator setup.
SELLER_RESOURCE_ENABLED=false
SELLER_RESOURCE_HOST=127.0.0.1
SELLER_RESOURCE_PORT=4191
# Local facilitator endpoint. Render overrides this with the private service host:port.
FACILITATOR_URL=http://127.0.0.1:4180
# Challenge-only mode serves a real x402 402 challenge but refuses all paid fulfillment.
SELLER_CHALLENGE_ONLY=false
# Optional canonical public HTTPS URL advertised in the x402 challenge after public hosting is verified.
SELLER_RESOURCE_PUBLIC_URL=

# Buyer-side Concordium agent. Its registered agentWallet must equal CCD_ACCOUNT_ADDRESS.
BUYER_BADGE=

# Concordium Testnet x402 facilitator. Keep the sponsor distinct from the buyer.
# Use the sponsor account address and a supported 32-byte hex Ed25519 account key.
CCD_FACILITATOR_ADDRESS=
CCD_FACILITATOR_PRIVATE_KEY=
FACILITATOR_HOST=127.0.0.1
FACILITATOR_PORT=4180
# Required true only for a Render private service; it refuses public binding and ephemeral storage.
FACILITATOR_PRIVATE_SERVICE=false
# Generate a random token locally (at least 32 characters); never commit it.
FACILITATOR_API_TOKEN=
# Keep false until you separately approve local Testnet signing/broadcast.
FACILITATOR_SETTLEMENT_ENABLED=false
FACILITATOR_MAX_AMOUNT_MICROCCD=1000000
# Operator-defined minimum sponsor balance reserve; chain submission remains authoritative for fee sufficiency.
FACILITATOR_MIN_SPONSOR_BALANCE_MICROCCD=10000
FACILITATOR_STORE_PATH=./data/facilitator-settlements

# Native CCD buyer payment ceiling in microCCD (6 decimals); code hard-rejects values above 1000000 (1 CCD).
MAX_SPEND_MICROCCD=
SELLER_ASSET=CCD

# Payments are disabled by default. Enabling requires a real, reviewed testnet setup.
PAYMENTS_ENABLED=false
CCD_ACCOUNT_ADDRESS=
CCD_PRIVATE_KEY=

# Optional local audit log path; must stay outside public/static directories.
AUDIT_LOG_PATH=./data/receipts.jsonl

# Optional Ollama-compatible agent host. Prompts go to this URL; loopback is the default.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Remote model hosts are blocked by default. If intentionally enabled, use HTTPS.
OLLAMA_ALLOW_REMOTE=false
